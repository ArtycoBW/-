# Локальная демонстрация. Для публичного размещения см. docs/02-Реализация.md.
DEMO_MODE=true
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
EMAIL_VERIFICATION_REQUIRED=false
PASSWORD_RECOVERY_ENABLED=false
EXPOSE_DEMO_MAIL=false
POSTGRES_PASSWORD=local-demo-change-me
DATABASE_URL=sqlite:///./.local/razryad.db
MODEL_PATH=ml/model.json
# Необязательно: SMTP. Без SMTP письма в .local/mail только при DEMO_MODE=true.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=hello@razryad.local
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
